# AirSave Backend Environment Variables

# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/airsave
MONGODB_URI=mongodb://localhost:27017/airsave

# PostgreSQL (opt in by uncommenting one datastore switch)
# DATA_STORE=postgres
# DATABASE_PROVIDER=postgres
# DB_PROVIDER=postgres
DATABASE_URL=postgresql://airsave:airsave_password@localhost:5432/airsave?schema=public
ENABLE_OUTBOX_WORKER=false

# Redis (Upstash Redis, Redis Cloud, Railway Redis)
# Use a rediss:// URL for TLS providers such as Upstash.
REDIS_URL=
REDIS_DISABLED=false
DASHBOARD_CACHE_TTL_SECONDS=45
TEMP_STATE_TTL_SECONDS=900
REDIS_CONNECT_TIMEOUT_MS=5000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=7d

# Client (Frontend URL)
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15m
RATE_LIMIT_MAX=100
