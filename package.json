{
  "name": "airsave",
  "version": "1.0.0",
  "description": "AirSave is a full-stack web application designed to help users track their savings, set financial goals, and monitor progress over time. It provides a simple and intuitive dashboard for managing personal finances.",
  "main": "gemini.js",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "cd backend && npm test",
    "verify:postgres": "node scripts/verifyPostgresLedger.js",
    "db:migrate:deploy": "cd backend && npm run db:migrate:deploy",
    "db:generate": "cd backend && npm run db:generate",
    "postdeploy:postgres": "npm run db:migrate:deploy && npm run verify:postgres",
    "cutover:check": "node scripts/postgresCutoverChecklist.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liwei254/AirSave.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Liwei254/AirSave/issues"
  },
  "homepage": "https://github.com/Liwei254/AirSave#readme",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^17.4.2",
    "fs": "^0.0.1-security",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  }
}
