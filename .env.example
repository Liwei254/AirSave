NODE_ENV=development
PORT=5000

# AirSave uses PostgreSQL + Prisma as the only datastore.
DATABASE_URL=postgresql://airsave:airsave_password@localhost:5432/airsave?schema=public

# Outbox worker can run separately with npm run worker:outbox from backend.
ENABLE_OUTBOX_WORKER=false

# Optional Redis cache/session-denylist backend. In-memory fallback is used when omitted.
REDIS_URL=

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
CLIENT_URLS=http://localhost:5173
