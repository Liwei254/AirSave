NODE_ENV=development
PORT=5000

# MongoDB remains the default datastore unless a Postgres switch below is set.
MONGO_URI=mongodb://127.0.0.1:27017/airsave
MONGODB_URI=mongodb://127.0.0.1:27017/airsave

# PostgreSQL cutover switches. MongoDB remains default until one is uncommented.
# DATA_STORE=postgres
# DATABASE_PROVIDER=postgres
# DB_PROVIDER=postgres
DATABASE_URL=postgresql://airsave:airsave_password@localhost:5432/airsave?schema=public

# Outbox worker can run separately with npm run worker:outbox from backend.
ENABLE_OUTBOX_WORKER=false

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
CLIENT_URLS=http://localhost:5173
